{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "turbounitconverter.vercel.app" }],
      "destination": "https://turbounitconverter.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.turbounitconverter.com" }],
      "destination": "https://turbounitconverter.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
